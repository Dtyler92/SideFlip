{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.posthog.com; form-action 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "functions": {
    "api/analytics/[operation].js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/analytics", "destination": "/api/analytics/preference" },
    { "source": "/api/analytics-worker", "destination": "/api/analytics/dispatch" },
    { "source": "/api/analytics-dispatch", "destination": "/api/analytics/dispatch" },
    { "source": "/api/analytics-preference", "destination": "/api/analytics/preference" },
    { "source": "/api/analytics-readiness", "destination": "/api/analytics/readiness" },
    { "source": "/api/maintenance-deletion-worker", "destination": "/api/analytics/maintenance-deletion" },
    { "source": "/((?!api|privacy|terms|support|assets|_next).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/maintenance-deletion-worker", "schedule": "0 3 * * *" }
  ]
}
